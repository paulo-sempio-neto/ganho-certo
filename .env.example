# Deploys publicos devem definir APP_ENV=production e trocar JWT_SECRET
# por um valor aleatorio forte, sem reutilizar este exemplo.
# Este arquivo e para desenvolvimento; nao importe seus valores locais no Render.
# Producao: lista exata e ordem de publicacao na secao de deploy do README.
# No Render, fixe PYTHON_VERSION (ex.: 3.12.13); PORT e fornecido pelo provedor.
APP_ENV=local
# POSTGRES_* abaixo sao usados pelo Docker Compose local.
# No Render, use a Internal Database URL completa em DATABASE_URL.
POSTGRES_USER=ganhocerto
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ganhocerto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ganhocerto:change_me@localhost:5432/ganhocerto
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Aceita URLs separadas por virgula ou array JSON; barra final e normalizada.
# Producao: deixe vazio ate cadastrar o frontend HTTPS (nenhuma origem liberada).
# Localhost e padrao somente em local/development/test; nao copie para producao.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Em producao: hosts publicos do backend, sem esquema/porta/caminho.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# IPs/CIDRs dos proxies confiaveis. Nunca use '*'. Vazio desabilita confianca.
FORWARDED_ALLOW_IPS=127.0.0.1
# Limite para corpos nao CSV; CSV conserva seu limite proprio de 1 MiB.
MAX_REQUEST_BODY_BYTES=1048576
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_IP_RATE_LIMIT=60
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ENTRIES=5000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Producao exige uma origem HTTPS real para os links de recuperacao de senha.
FRONTEND_BASE_URL=http://localhost:5173
# Billing fica desabilitado por padrao. Para beta com cobranca real, habilite
# Mercado Pago somente no backend e configure segredos no provedor de deploy.
BILLING_PROVIDER=none
# Omita quando billing estiver desabilitado; valor vazio nao e um Decimal valido.
# BILLING_PRO_MONTHLY_AMOUNT=29.90
BILLING_CURRENCY_ID=BRL
BILLING_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Token opcional para endpoint interno de aprendizado da beta.
# Deixe vazio para desabilitar /internal/beta/summary.
BETA_ADMIN_TOKEN=
# Em APP_ENV=local, sem SMTP configurado, emails de recuperacao nao sao enviados.
# Em APP_ENV=production, SMTP_HOST, SMTP_FROM_EMAIL e TLS sao obrigatorios.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
